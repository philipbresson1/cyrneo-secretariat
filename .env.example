# Copier en .env.local (jamais commité).

# Supabase (projet Secretariat) — clé service-role, PC uniquement
NEXT_PUBLIC_SUPABASE_URL=https://rxevmfytlxtdjqymznfh.supabase.co
# Supabase > Project Settings > API Keys > « service_role » (ou clé secrète sb_secret_…)
SUPABASE_SERVICE_ROLE=xxxx

# Claude
ANTHROPIC_API_KEY=sk-ant-xxxx

# Boîtes OVH du groupe (ssl0.ovh.net) : mot de passe de la boîte, celui du webmail OVH
MAIL_INFO_CYRNEO_UTILISATEUR=info@groupecyrneo.com
MAIL_INFO_CYRNEO_MOTDEPASSE=xxxx
MAIL_FACTURATION_CYRNEO_UTILISATEUR=facturation@groupecyrneo.com
MAIL_FACTURATION_CYRNEO_MOTDEPASSE=xxxx

# Dolibarr : clé API de l'utilisateur dédié (Utilisateurs > fiche > onglet « Clé API »)
DOLIBARR_API_KEY=xxxx

# Mode du secrétariat : simulation (rien ne part), test (tout part vers l'adresse et la bulle
# de test), reel (production). L'adresse de test reçoit toutes les réponses automatiques en test.
SECRETARIAT_MODE=simulation
SECRETARIAT_ADRESSE_TEST=
# Modèle Claude du tri et des rappels (défaut claude-opus-5-5). claude-haiku-5-5 : environ 40 fois moins cher.
# SECRETARIAT_MODELE=claude-haiku-5-5
# Facultatif : bulle Rainbow de test (par défaut « Test secrétariat »)
# SECRETARIAT_BULLE_TEST=Test secrétariat

# Clé d'accès aux pages /journal et /interventions (au choix, longue)
SECRETARIAT_CLE=xxxx

# Rainbow : compte dédié membre de toutes les bulles + application developers.openrainbow.com
RAINBOW_LOGIN=secretariat@groupecyrneo.com
RAINBOW_MOTDEPASSE=xxxx
RAINBOW_APP_ID=xxxx
RAINBOW_APP_SECRET=xxxx
RAINBOW_HOTE=official

# Agendas de l'écran d'accueil : « Adresse secrète au format iCal » de chaque agenda Google
AGENDA_ICS_DEBOUCHAGE_SA=https://calendar.google.com/calendar/ical/debouchagesudassai%40gmail.com/private-xxxx/basic.ics
AGENDA_ICS_AGENT_SA=https://calendar.google.com/calendar/ical/agent.sudassai%40gmail.com/private-xxxx/basic.ics
AGENDA_ICS_AGENT_MS2A=https://calendar.google.com/calendar/ical/agent.ms2a%40gmail.com/private-xxxx/basic.ics
AGENDA_ICS_ENTRETIEN_COULEURS=https://calendar.google.com/calendar/ical/entretienetcouleurs%40gmail.com/private-xxxx/basic.ics
AGENDA_ICS_SUD_TRAVAUX=https://calendar.google.com/calendar/ical/sas.sudtravaux%40gmail.com/private-xxxx/basic.ics

# Agendas Google : clé JSON du compte de service (chemin du fichier), et agenda Google des essais en mode test
GOOGLE_COMPTE_SERVICE=C:/Cyrneo/cyrneo-secretariat-compte-service.json
# SECRETARIAT_AGENDA_TEST=adresse-de-l-agenda-d-essai@gmail.com
